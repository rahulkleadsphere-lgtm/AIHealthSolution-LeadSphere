# =====================================================================
# SevaSetu Comprehensive Git Ignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. Tests & Quality Assurance
# ---------------------------------------------------------------------
test_*.py
*_test.py
test_*.js
test_*.ts
test_*.tsx
*.test.js
*.test.ts
*.test.jsx
*.test.tsx
*.spec.js
*.spec.ts
*.spec.jsx
*.spec.tsx
tests/
__tests__/
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# ---------------------------------------------------------------------
# 2. Seed Data & Seeding Scripts
# ---------------------------------------------------------------------
seed_*.py
*_seed.py
seeds/
seeders/
seed_*.sql
hospital_directory.json
*.seed

# ---------------------------------------------------------------------
# 3. Check, Verification & Audit Scripts
# ---------------------------------------------------------------------
check_*.py
check_*.js
check_*.ts
verify_*.py
verify_*.js
verify_*.ts
debug_*.py

# ---------------------------------------------------------------------
# 4. Scratchpads & Temporary Directories
# ---------------------------------------------------------------------
scratch/
scratchpad*
temp/
tmp/
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo

# ---------------------------------------------------------------------
# 5. Environment Variables & Secrets (NEVER COMMIT)
# ---------------------------------------------------------------------
.env
.env.*
*.env
env.production
env.local
env (*)*
secret.txt
credentials*.json
service-account*.json
*.pem
*.key
*.cert

# Allow safe example templates & TypeScript definition files
!**/.env.example
!.env.example
!**/src/env.d.ts
!**/src/vite-env.d.ts

# ---------------------------------------------------------------------
# 6. Python Artifacts & Environments
# ---------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/ENV/
**/env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Explicitly ensure frontend source library is never ignored
!**/src/lib/**

# ---------------------------------------------------------------------
# 7. Node.js & Frontend Artifacts
# ---------------------------------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*
bun.lockb
tsconfig.tsbuildinfo

# ---------------------------------------------------------------------
# 8. Local Databases & Logs
# ---------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.log

# ---------------------------------------------------------------------
# 9. IDE, OS & System Junk
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
