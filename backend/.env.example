# Application Settings
APP_NAME="SevaSetu AI Health Chatbot"
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,https://health-ai-chatbot.vercel.app

# Database Configuration (MySQL / PostgreSQL)
# Option A: Full Connection String
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/health_db
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/defaultdb?sslmode=require

# Option B: Individual DB Settings (MySQL default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_db
DB_USER=root
DB_PASSWORD=password

# Groq AI Configuration (Get key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
AI_MODEL=llama-3.1-8b-instant
VISION_MODEL=qwen/qwen3.8-27b

# Cloudinary Storage Configuration (Get credentials from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Authentication & JWT Security
SECRET_KEY=your-secret-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
